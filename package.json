{
  "name": "terminal-workspace-tauri",
  "private": false,
  "license": "Apache-2.0",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "review": "vite --host 127.0.0.1 --port 5177 --strictPort true",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cockpit:capture": "node scripts/capture-cockpit.mjs --crop-header",
    "doctor": "node scripts/termfleet-doctor.mjs",
    "migrate:session-ids": "node scripts/migrate-session-ids.mjs --apply",
    "verify:prerequisites": "node scripts/verify-prerequisites.mjs",
    "verify:canvas-renderer": "playwright test canvas-renderer",
    "verify:grid-diff": "playwright test grid-diff",
    "verify:legacy-prompt-repair": "playwright test legacy-prompt-repair",
    "verify:legacy-prompt-live": "scripts/verify-legacy-prompt-repair.sh",
    "verify:keymap": "playwright test keymap",
    "verify:terminal-mouse": "playwright test terminal-mouse",
    "verify:grid-resize": "playwright test grid-resize",
    "verify:selection": "playwright test selection",
    "verify:box-glyph": "playwright test box-glyph",
    "verify:canvas-all": "playwright test canvas-renderer grid-diff legacy-prompt-repair keymap terminal-mouse grid-resize selection box-glyph map-terminal-rendering",
    "verify:terminal-reliability": "scripts/verify-terminal-reliability.sh",
    "verify:terminal-reliability:live": "TERMFLEET_TERMINAL_RELIABILITY_LIVE=1 scripts/verify-terminal-reliability.sh",
    "verify:release": "scripts/verify-release.sh",
    "release:install": "scripts/install-release.sh",
    "verify:installed-release": "scripts/verify-installed-release.sh",
    "verify:installed-restart": "scripts/verify-installed-restart-smoke.sh",
    "opencode:install-plugin": "node scripts/termfleet-install-opencode-plugin.mjs",
    "verify:opencode-status": "playwright test opencode-status-plugin",
    "verify:opencode-tui-resize": "python3 scripts/verify-opencode-tui-resize.py",
    "verify:map-terminals": "node scripts/verify-map-terminals.mjs",
    "verify:canvas-arrange": "playwright test canvas-arrange canvas-node-reorder map-toolbar --reporter=line",
    "verify:terminal-summary-visual": "playwright test tests/terminal-summary-visual.spec.ts --reporter=line",
    "verify:terminal-header-contract": "playwright test tests/terminal-summary-visual.spec.ts -g \"map header rejects slash-command prompt echoes\" --reporter=line",
    "evidence:bundle": "node scripts/export-evidence-bundle.mjs",
    "verify:evidence-bundle": "node scripts/verify-evidence-bundle.mjs",
    "verify:oss-readiness": "node scripts/verify-oss-readiness.mjs",
    "verify:public-audit": "node scripts/verify-public-audit.mjs",
    "verify:readme-recovery": "node scripts/verify-readme-recovery.mjs",
    "verify:developer-preview": "node scripts/verify-developer-preview.mjs",
    "verify:agent-status-summary": "node scripts/verify-agent-status-summary-server.mjs",
    "verify:task-identity": "node scripts/verify-task-identity.mjs",
    "verify:cockpit-target": "node scripts/verify-cockpit-target.mjs",
    "cockpit:tasks": "node scripts/monitor-cockpit-tasks.mjs",
    "monitor:cockpit-tasks": "node scripts/monitor-cockpit-tasks.mjs --watch --jsonl",
    "watchdog:cockpit-labels": "node scripts/monitor-cockpit-tasks.mjs --watch --jsonl --alert-on-fail --notify-on-fail --interval-ms=2000 --max-age-s=30",
    "verify:cockpit-all": "node scripts/monitor-cockpit-tasks.mjs --verify",
    "audit:panes": "playwright test tests/pane-label-audit.spec.ts --reporter=line",
    "agent-status:ollama": "node scripts/agent-status-summary-ollama.mjs",
    "termfleetctl": "node scripts/termfleetctl.mjs",
    "verify:termfleetctl": "node scripts/verify-termfleetctl.mjs",
    "verify:agent-adapter": "scripts/verify-agent-provider-adapter-headless.sh",
    "verify:canvas-terminal": "scripts/verify-canvas-terminal.sh",
    "verify:canvas-live": "scripts/verify-canvas-live.sh",
    "verify:agent-restore-visible": "scripts/verify-agent-restore-visible.sh",
    "verify:ask-user-question-live": "scripts/verify-ask-user-question-live.sh",
    "verify:real-dev-window": "scripts/verify-real-dev-window.sh",
    "verify:terminal-task-scroll-stability": "scripts/verify-terminal-task-scroll-stability.sh",
    "verify:terminal-header-prompt-live": "scripts/verify-terminal-header-prompt-live.sh",
    "verify:terminal-headers-live-all": "scripts/verify-terminal-headers-live-all.sh",
    "verify:bracketed-paste": "scripts/verify-bracketed-paste.sh",
    "verify:clipboard-paste": "scripts/verify-clipboard-paste.sh",
    "verify:clipboard-all-launchers": "scripts/verify-clipboard-all-launchers.sh",
    "verify:resize-storm": "scripts/verify-resize-storm.sh",
    "verify:scrollback-reattach": "scripts/verify-scrollback-reattach.sh",
    "verify:map-shell-anchor": "scripts/verify-map-shell-anchor.sh",
    "verify:zellij-map": "scripts/verify-zellij-map.sh",
    "verify:terminal-rendering": "node scripts/verify-terminal-rendering.mjs",
    "verify:tui-color-env": "scripts/verify-tui-color-env.sh",
    "verify:tauri-dev-performance": "scripts/verify-tauri-dev-performance.sh",
    "verify:standalone-daemon": "scripts/verify-standalone-daemon-smoke.sh",
    "verify:installed-pane-close": "scripts/verify-installed-pane-close.sh",
    "verify:restart-restore": "python3 scripts/verify-restart-restore.py",
    "verify:daemon-survival": "CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-1} CARGO_PROFILE_DEV_DEBUG=0 cargo test --manifest-path src-tauri/Cargo.toml --test daemon_survival -- --nocapture",
    "verify:daemon-restart": "scripts/verify-daemon-survives-restart.sh",
    "verify:pty-100": "CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-1} cargo test --manifest-path src-tauri/Cargo.toml manager_handles_one_hundred_consecutive_pty_sessions -- --nocapture",
    "verify:isolated-stress": "node scripts/verify-isolated-stress.mjs",
    "verify:reliability-loop": "node scripts/termfleet-doctor.mjs && npm run verify:pty-100 && npm run verify:daemon-restart",
    "verify:daemon-latency": "node scripts/verify-daemon-latency.mjs",
    "verify:map-terminal-latency": "node scripts/verify-map-terminal-latency.mjs",
    "verify:map-terminal-latency:live": "scripts/verify-map-terminal-latency-live.sh",
    "verify:rust-warnings": "scripts/verify-rust-warnings.sh",
    "verify:tauri-performance": "scripts/verify-tauri-performance.sh",
    "trace:terminal-latency": "node scripts/summarize-terminal-latency-trace.mjs",
    "verify:typography": "node scripts/verify-typography.mjs",
    "verify:file-explorer": "playwright test tests/file-explorer.spec.ts --reporter=line",
    "verify:visual": "scripts/verify-visual-evidence.sh",
    "tauri": "tauri",
    "tauri:dev": "scripts/tauri-dev-with-status.sh",
    "verify:zellij-shortcuts": "scripts/verify-zellij-shortcuts.sh",
    "cockpit:snapshot": "node scripts/cockpit-snapshot.mjs",
    "gate": "node scripts/termfleet-gate.mjs",
    "verify:task-line": "npx playwright test tests/task-line-sweep.spec.ts tests/task-line.spec.ts tests/task-line-plumbing.spec.ts tests/task-line-live-records.spec.ts tests/task-line-coverage.spec.ts tests/session-transcript.spec.ts tests/task-identity-ladder.spec.ts --reporter=line",
    "cockpit:why": "npx playwright test tests/task-line-coverage.spec.ts tests/task-line-live-records.spec.ts --reporter=line"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/rubik": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.10",
    "@xterm/addon-web-links": "^0.11",
    "@xterm/addon-webgl": "^0.18",
    "@xterm/xterm": "^5",
    "allotment": "^1.20.5",
    "lucide-react": "^1.16.0",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "vite": "^6.4.3"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "5.1.16",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    }
  }
}
