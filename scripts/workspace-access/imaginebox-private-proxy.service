[Unit]
Description=Private Tailscale adapter for ImagineBox
Wants=imaginebox-workspace.service
After=imaginebox-workspace.service

[Service]
EnvironmentFile=%h/.config/termfleet/workspace-access.env
ExecStart=/usr/bin/env node ${TERMFLEET_SOURCE}/scripts/private-workspace-proxy.mjs 8811 8810 ${WORKSPACE_ORIGIN} ${STUDIO_ORIGIN}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
