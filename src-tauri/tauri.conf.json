{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "TermFleet",
  "version": "0.2.2",
  "identifier": "io.github.endlessblink.termfleet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort true",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TermFleet",
        "width": 1600,
        "height": 1000,
        "minWidth": 1400,
        "minHeight": 900,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Keyboard-first terminal cockpit",
    "longDescription": "TermFleet is a terminal cockpit / multi-terminal operations workspace: a single keyboard-first developer operations center with a user-local PTY daemon, a Canvas2D terminal renderer, and a strategic operations map. Linux is the first release target.",
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "resources": {
      "../scripts/termfleet-connect-agents.mjs": "agent-hooks/termfleet-connect-agents.mjs",
      "../scripts/termfleet-claude-status-hook.mjs": "agent-hooks/termfleet-claude-status-hook.mjs",
      "../scripts/termfleet-codex-status-hook.mjs": "agent-hooks/termfleet-codex-status-hook.mjs",
      "../scripts/termfleet-opencode-status-plugin.js": "agent-hooks/termfleet-opencode-status-plugin.js",
      "../scripts/lib/agent-status-paths.mjs": "agent-hooks/lib/agent-status-paths.mjs",
      "../scripts/lib/agent-status-lifecycle.mjs": "agent-hooks/lib/agent-status-lifecycle.mjs",
      "../scripts/lib/agent-status-goal.mjs": "agent-hooks/lib/agent-status-goal.mjs",
      "../scripts/lib/agent-status-activity.mjs": "agent-hooks/lib/agent-status-activity.mjs",
      "../scripts/lib/single-chat-owner.mjs": "agent-hooks/lib/single-chat-owner.mjs",
      "../scripts/lib/agent-exit-log.mjs": "agent-hooks/lib/agent-exit-log.mjs",
      "../scripts/lib/codex-pane-owner.mjs": "agent-hooks/lib/codex-pane-owner.mjs",
      "../scripts/lib/context-handoff.mjs": "agent-hooks/lib/context-handoff.mjs",
      "../scripts/lib/session-event-journal.mjs": "agent-hooks/lib/session-event-journal.mjs",
      "../scripts/termfleet-session-observation.mjs": "agent-hooks/termfleet-session-observation.mjs",
      "../scripts/lib/session-soak.mjs": "agent-hooks/lib/session-soak.mjs",
      "../shared/sessionObservation.mjs": "shared/sessionObservation.mjs",
      "../shared/sessionCompatibility.mjs": "shared/sessionCompatibility.mjs",
      "../shared/sessionState.mjs": "shared/sessionState.mjs",
      "../shared/sessionEnvelope.mjs": "shared/sessionEnvelope.mjs",
      "../shared/sessionSnapshot.mjs": "shared/sessionSnapshot.mjs",
      "../scripts/lib/handoff-inject.mjs": "agent-hooks/lib/handoff-inject.mjs"
    }
  }
}
